// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  MOBILE_NETWORKING
  CREDIT_CARD
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum Direction {
  IN
  OUT
}

// TODO: I will implement this later
enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id        String    @id @default(uuid(7))
  name      String
  email     String    @unique
  password  String
  avatar    String
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  //Relations
  accounts              Account[]
  categories            Category[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  refreshTokens         RefreshToken[]
  // notifications         Notification[] TODO: notifications
  transactions          Transaction[]
  transfersSent         Transfer[]             @relation("transferSender")
  transfersReceived     Transfer[]             @relation("transferReceiver")

  @@index([isDeleted])
}

model Account {
  id        String  @id @default(uuid(7))
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isDeleted Boolean @default(false)

  name      String
  type      AccountType
  currency  String      @default("USD")
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  // Relations
  transactions          Transaction[]          @relation("accountTransactions")
  recurringTransactions RecurringTransaction[]

  @@index([isDeleted])
  @@index([userId])
}

model Transaction {
  id         String    @id @default(uuid(7))
  accountId  String
  account    Account   @relation(name: "accountTransactions", fields: [accountId], references: [id], onUpdate: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onUpdate: Cascade)
  categoryId String? // null for transfers, they have no category
  category   Category? @relation(fields: [categoryId], references: [id], onUpdate: Cascade)

  // A transfer is two linked legs (one IN, one OUT); transferId is null for income/expense
  transferId String? // null for income/expense
  transfer   Transfer? @relation(fields: [transferId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type      TransactionType
  direction Direction // IN = money into accountId, OUT = money out of accountId
  amount    Decimal         @db.Decimal(12, 2)
  note      String? // note for themselves
  date      DateTime
  isDeleted Boolean         @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountId])
  @@index([userId])
  @@index([transferId])
  @@index([isDeleted])
}

model Transfer {
  id         String         @id @default(uuid(7))
  fromUserId String
  fromUser   User           @relation("transferSender", fields: [fromUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toUserId   String
  toUser     User           @relation("transferReceiver", fields: [toUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memo       String? // both share this transfer memo
  status     TransferStatus @default(COMPLETED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  legs Transaction[]

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model Category {
  id        String          @id @default(uuid(7))
  name      String
  userId    String? // Optional for global categories
  user      User?           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  icon      String? // This can an url or emoji
  type      TransactionType // Transaction category type
  isDeleted Boolean         @default(false)

  // Relations
  transactions Transaction[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name]) // user can't have duplicate categories
  @@index([isDeleted])
}

model Budget {
  id        String  @id @default(uuid(7))
  name      String
  userId    String
  user      User    @relation(fields: [userId], references: [id], onUpdate: Cascade)
  amount    Decimal @db.Decimal(12, 2)
  isDeleted Boolean @default(false)

  // Relations
  // BudgetCategory BudgetCategory[]

  startDate DateTime
  endDate   DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, startDate, endDate])
  @@index([isDeleted])
}

model RecurringTransaction {
  id         String   @id @default(uuid(7))
  userId     String
  user       User     @relation(fields: [userId], references: [id], onUpdate: Cascade)
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onUpdate: Cascade)

  amount            Decimal            @db.Decimal(12, 2)
  note              String?
  frequency         RecurringFrequency
  startDate         DateTime
  endDate           DateTime?
  nextExecutionDate DateTime
  status            RecurringStatus    @default(ACTIVE)
  isDeleted         Boolean            @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isDeleted])
  @@index([userId])
  @@index([status])
  @@index([nextExecutionDate])
}

model RefreshToken {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([token])
}
